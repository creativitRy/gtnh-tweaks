{
  "name": "gtnh-tweaks",
  "private": true,
  "version": "0.0.1",
  "repository": "https://github.com/creativitRy/gtnh-tweaks",
  "workspaces": [
    "core",
    "scripts/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p core",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "bun test --timeout 120000"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@iconify/svelte": "^5.2.4",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/bun": "^1.3.4",
    "@types/node": "^22.20.5",
    "brotli-wasm": "^3.0.1",
    "byte-base64": "^1.1.0",
    "diff": "^8.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "file-saver": "^2.0.5",
    "globals": "^16.5.0",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "sass": "^1.107.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@gtnh-tweaks/core": "workspace:*",
    "@types/file-saver": "^2.0.7"
  }
}
